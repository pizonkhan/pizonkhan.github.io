{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pk-site-analytics",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	// Cloudflare's own request logging is disabled deliberately: no IP address and no raw
	// user agent may be retained anywhere, and Workers Logs would otherwise keep both.
	"observability": {
		"enabled": false
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://pizonkhan.github.io,http://localhost:3000,http://127.0.0.1:3000"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pk-site-analytics",
			"database_id": "57bd0ba1-e2a7-428c-ad24-08c28d491b52",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"17 1 * * *"
		]
	}
}